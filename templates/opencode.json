{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "webfetch": "deny",
    "websearch": "deny",
    "doom_loop": "ask",
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "python3 {SKILL}/flow.py new *": "allow",
      "python3 {SKILL}/flow.py triage *": "allow",
      "python3 {SKILL}/flow.py dec *": "allow",
      "python3 {SKILL}/flow.py status *": "allow",
      "python3 {SKILL}/flow.py resume *": "allow",
      "python3 {SKILL}/flow.py checkpoint *": "allow",
      "python3 {SKILL}/flow.py report *": "allow",
      "python3 {SKILL}/flow.py audit *": "allow",
      "python3 {SKILL}/flow.py next *": "allow",
      "python3 {SKILL}/flow.py gate *": "allow",
      "python3 {SKILL}/flow.py review *": "allow",
      "python3 {SKILL}/flow.py review-loop *": "allow",
      "python3 {SKILL}/flow.py help": "allow",
      "python3 {SKILL}/flow.py doctor": "allow",
      "python3 {SKILL}/flow.py version": "allow",
      "python3 {SKILL}/case.py *": "allow",
      "python3 {SKILL}/winemu/winemu.py *": "allow",
      "python3 {SKILL}/winemu/summarize.py *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "ls *": "allow",
      "wc *": "allow",
      "sha256sum *": "allow",
      "file *": "allow",
      "strings *": "allow",
      "*;*": "ask",
      "*|*": "ask",
      "*&*": "ask",
      "*`*": "ask",
      "*$(*": "ask",
      "*>*": "ask",
      "python3 *winemu.py *--plugin*": "ask",
      "python3 *winemu.py *--resume*": "ask",
      "python3 *flow.py next *--accept*": "ask",
      "python3 *flow.py opencode*": "deny",
      "python3 *flow.py rules*": "deny",
      "python3 *flow.py session*": "deny",
      "python3 *flow.py setup*": "deny",
      "wine *": "deny",
      "wine64 *": "deny",
      "* wine *": "deny",
      "*/wine *": "deny",
      "qemu-*": "deny",
      "* qemu-*": "deny",
      "*rea capture*": "deny",
      "*debug-with-gdb*": "deny",
      "./*": "deny",
      "chmod *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "nc *": "deny",
      "ncat *": "deny",
      "socat *": "deny",
      "telnet *": "deny"
    }
  }
}
