{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "webfetch": "deny",
    "websearch": "deny",
    "doom_loop": "ask",
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "python3 *flow.py *": "allow",
      "python3 *case.py *": "allow",
      "python3 *winemu.py *": "allow",
      "python3 *summarize.py *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "ls *": "allow",
      "wc *": "allow",
      "sed -n *": "allow",
      "sha256sum *": "allow",
      "file *": "allow",
      "strings *": "allow",
      "wine *": "deny",
      "wine64 *": "deny",
      "* wine *": "deny",
      "*/wine *": "deny",
      "qemu-*": "deny",
      "* qemu-*": "deny",
      "*rea capture*": "deny",
      "*debug-with-gdb*": "deny",
      "./*": "deny",
      "chmod *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "nc *": "deny",
      "ncat *": "deny",
      "socat *": "deny",
      "telnet *": "deny"
    }
  }
}
